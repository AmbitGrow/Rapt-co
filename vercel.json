{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/company-profile.pdf",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"RAPT-and-Co-Company-Profile.pdf\"" }
      ]
    }
  ]
}
